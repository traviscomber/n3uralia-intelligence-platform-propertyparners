{
  "schemaVersion": 1,
  "targetDelivery": "2026-09-30",
  "status": "ready",
  "ownershipClasses": [
    "client-owned-canonical",
    "client-core",
    "shared-contract",
    "n3uralia-proprietary",
    "secret-or-credential",
    "requires-review"
  ],
  "rules": {
    "clientMaterialRemainsClientOwned": true,
    "repositoryLocationDoesNotChangeOwnership": true,
    "normalizationDoesNotChangeOwnership": true,
    "n3uraliaProtectionScope": "reusable-differential-methodology-only",
    "deliverableMustExcludeSecrets": true,
    "deliverableMustExcludeConfirmedN3uraliaProprietarySource": true,
    "readyStatusMustResolveRequiresReview": true
  },
  "classifications": [
    {
      "pattern": "docs/canonical/**",
      "class": "client-owned-canonical",
      "delivery": "include",
      "note": "Canonical client-approved material remains client property."
    },
    {
      "pattern": "data/**",
      "class": "client-owned-canonical",
      "delivery": "include-after-secret-scan"
    },
    {
      "pattern": "public/**",
      "class": "client-core",
      "delivery": "include-after-license-and-secret-scan"
    },
    {
      "pattern": "app/**",
      "class": "client-core",
      "delivery": "include-after-exposure-audit"
    },
    {
      "pattern": "components/**",
      "class": "client-core",
      "delivery": "include-after-exposure-audit"
    },
    {
      "pattern": "supabase/migrations/**",
      "class": "client-core",
      "delivery": "include-after-security-review",
      "note": "Property Partners schema, permissions and operational data model remain client-core."
    },
    {
      "pattern": ".github/**",
      "class": "shared-contract",
      "delivery": "include-after-secret-scan"
    },
    {
      "pattern": "scripts/**",
      "class": "shared-contract",
      "delivery": "include-after-secret-scan",
      "note": "Repository-specific build, verification and acceptance tooling. Differential N3uralia runtime intelligence remains separately classified and excluded."
    },
    {
      "pattern": "lib/**",
      "class": "client-core",
      "delivery": "include-after-exposure-audit",
      "note": "Property Partners application libraries are client-core except explicitly classified N3uralia proprietary modules below."
    },
    {
      "pattern": "lib/n3uralia-runtime-contract.ts",
      "class": "shared-contract",
      "delivery": "include"
    },
    {
      "pattern": "lib/n3uralia-runtime-client.ts",
      "class": "shared-contract",
      "delivery": "include-after-secret-scan"
    },
    {
      "pattern": "lib/n3uralia-intelligence-engine.ts",
      "class": "n3uralia-proprietary",
      "delivery": "exclude-before-transfer"
    },
    {
      "pattern": "lib/n3uralia-intelligence-gateway.ts",
      "class": "n3uralia-proprietary",
      "delivery": "exclude-before-transfer",
      "note": "Contains reusable orchestration, parity evaluation and direct coupling to the proprietary engine."
    },
    {
      "pattern": ".env*",
      "class": "secret-or-credential",
      "delivery": "exclude"
    },
    {
      "pattern": "**/*.pem",
      "class": "secret-or-credential",
      "delivery": "exclude"
    },
    {
      "pattern": "**/*.key",
      "class": "secret-or-credential",
      "delivery": "exclude"
    },
    {
      "pattern": "tests/**",
      "class": "shared-contract",
      "delivery": "include-after-secret-scan",
      "note": "Regression and acceptance tests are part of the reproducible contracted product evidence."
    }
  ],
  "approval": {
    "technical": "N3uralia technical delivery-boundary review complete",
    "security": "N3uralia security and exposure-boundary review complete",
    "contractual": "N3uralia ownership classification review complete; client acceptance remains separate",
    "approvedCommit": "cde1981f32bc7ad95a439897dbb74bf09148c0b5",
    "approvedAt": "2026-09-18T16:10:00-03:00"
  },
  "internalReview": {
    "asOf": "2026-09-18",
    "technical": "completed",
    "security": "completed",
    "evidence": [
      "N3uralia IP Boundaries passed on the current closeout branch before merge.",
      "Proprietary runtime modules remain server-only and classified exclude-before-transfer.",
      "Client canonical data, migrations, operational rules and contracted application code remain client-owned/client-core."
    ]
  }
}
