  "methodology": {
    "house": {
      "commercialValueFormula": "built_area_m2 * built_rate_uf_m2 + land_area_m2 * land_rate_uf_m2",
      "comparableAreaFormula": "built_area_m2 + land_area_m2 / 4",
      "comparableUfM2Formula": "price_uf / (built_area_m2 + land_area_m2 / 4)",
      "subjectWeightedUfM2Formula": "commercial_value_uf / (built_area_m2 + land_area_m2 / 4)",
      "rule": "Construction and land rates remain separate inputs; never collapse them into one rate."
    },
    "apartment": {
      "commercialValueFormula": "useful_area_m2 * applied_useful_uf_m2",
      "portalComparableAreaFormula": "useful_area_m2 + (total_area_m2 - useful_area_m2) / 2",
      "portalComparableUfM2Formula": "price_uf / (useful_area_m2 + (total_area_m2 - useful_area_m2) / 2)",
      "cbrsComparableUfM2Formula": "price_uf / registered_area_m2",
      "subjectWeightedAreaFormula": "useful_area_m2 + terrace_area_m2 / 2",
      "subjectWeightedUfM2Formula": "commercial_value_uf / (useful_area_m2 + terrace_area_m2 / 2)",
      "rule": "CBRS area is used as registered source area unless audited semantics prove it is specifically useful area."
    },
    "publication": {
      "scenariosPct": [
        0,
        5,
        10
      ],
      "formula": "commercial_value_uf / (1 - margin_pct/100)",
      "semantics": "Publication scenario preserves the commercial value after the assumed negotiation margin.",
      "productGuidance": "+5% may be highlighted as the standard recommendation, but 0/5/10 remain canonical evidence."
    }
