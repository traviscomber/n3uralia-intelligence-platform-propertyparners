  "definitions": {
    "managementScore": {
      "formula": "0.4 * portfolioQuality + 0.3 * followUpQuality + 0.3 * conversionQuality",
      "weights": {
        "portfolioQuality": 0.4,
        "followUpQuality": 0.3,
        "conversionQuality": 0.3
      },
      "subscoreWeight": 0.3333333333
    },
    "portfolioQuality": [
      {
        "key": "portfolioGoal",
        "label": "Meta cartera",
        "formula": "min(portfolio / goal, 1) * 100",
        "meaning": "Cumple meta props"
      },
      {
        "key": "requirementsByPropertyType",
        "label": "Reqs x Tipo Prop",
        "formula": "min(requirementRatio, 1) * 100",
        "meaning": "Reqs vs benchmark"
      },
      {
        "key": "priceQuality",
        "label": "Calidad Precio",
        "formula": "ratio <= 1.05 ? 100 : ratio <= 1.10 ? 50 : 0",
        "meaning": "Pricing vs valorización"
      }
    ],
    "followUpQuality": [
      {
        "key": "classifiedLeads",
        "label": "% Leads Clasif",
        "formula": "classifiedLeads / activeLeads * 100",
        "meaning": "Clasifica leads"
      },
      {
        "key": "leadsManagedWithin90Days",
        "label": "% Leads c-g90",
        "formula": "(1 - unmanaged90DayLeads / activeLeads) * 100",
        "meaning": "Leads no abandonados"
      },
      {
        "key": "priorityLeadsManagedWithin15Days",
        "label": "%LeadsA c-g15",
        "formula": "(1 - unmanaged15DayPriorityLeads / priorityClients) * 100",
        "meaning": "Leads A contactados"
      }
    ],
    "conversionQuality": [
      {
        "key": "completedVisitsGoal",
        "label": "Vis Realiz/Meta",
        "formula": "min(completedVisits / visitGoal, 1) * 100",
        "meaning": "Cumple meta visitas"
      },
      {
        "key": "completedScheduledVisits",
        "label": "%Vis realizad/agend",
        "formula": "completedVisits / scheduledVisits * 100",
        "meaning": "Cumple agenda"
      },
      {
        "key": "sixMonthCloseRate",
        "label": "TC 6m/leads tot",
        "formula": "min(sixMonthCloseRatePercent, 2.86) * 35",
        "meaning": "Cierra negocios"
      }
    ],
    "trafficLights": {
      "goalCompliance": [
        {
          "status": "red",
          "condition": "value < 90"
        },
        {
          "status": "yellow",
          "condition": "value >= 90 && value < 100"
        },
        {
          "status": "green",
          "condition": "value >= 100"
        }
      ],
      "yearOverYearGrowth": [
        {
          "status": "red",
          "condition": "value < 0"
        },
        {
          "status": "yellow",
          "condition": "value >= 0 && value < 20"
        },
        {
          "status": "green",
          "condition": "value >= 20"
        }
      ],
      "qualityScore": [
        {
          "status": "red",
          "condition": "value < 50"
        },
        {
          "status": "yellow",
          "condition": "value >= 50 && value < 70"
        },
        {
          "status": "green",
          "condition": "value >= 70"
        }
      ]
    },
    "personClassifications": [
      {
        "key": "star",
        "label": "Estrella",
        "condition": "portfolio >= 70 && followUp >= 70 && conversion >= 70"
      },
      {
        "key": "potential",
        "label": "Potencial",
        "condition": "oneScore >= 70 && remainingScores >= 50"
      },
      {
        "key": "capturer",
        "label": "Captador",
        "condition": "portfolio >= 70"
      },
      {
        "key": "seller",
        "label": "Vendedor",
        "condition": "conversion >= 70"
      },
      {
        "key": "persistent",
        "label": "Perseverante",
        "condition": "followUp >= 70"
      },
      {
        "key": "risk",
        "label": "Riesgo",
        "condition": "atLeastTwoScores < 30"
      },
      {
        "key": "development",
        "label": "Desarrollo",
        "condition": "fallback"
      }
    ],
    "semanticSeparation": {
      "boardClosings": "management_credited_sales",
      "boardSalesUf": "management_credited_sales_uf",
      "operationalClosings": "sales",
      "operationalSalesUf": "sales_uf"
    }
