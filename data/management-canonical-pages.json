  "definitions": {
    "managementScore": {
      "formula": "0.4 * portfolioQuality + 0.3 * followUpQuality + 0.3 * conversionQuality",
      "weights": {
        "portfolioQuality": 0.4,
        "followUpQuality": 0.3,
        "conversionQuality": 0.3
      },
      "subscoreWeight": 0.3333333333
    },
    "portfolioQuality": [
      {
        "key": "portfolioGoal",
        "label": "Meta cartera",
        "formula": "min(portfolio / goal, 1) * 100",
        "meaning": "Cumplimiento de la meta de propiedades"
      },
      {
        "key": "requirementsByPropertyType",
        "label": "Requerimientos por tipo de propiedad",
        "formula": "min(requirementRatio, 1) * 100",
        "meaning": "Requerimientos frente al benchmark"
      },
      {
        "key": "priceQuality",
        "label": "Calidad de precio",
        "formula": "ratio <= 1.05 ? 100 : ratio <= 1.10 ? 50 : 0",
        "meaning": "Precio publicado frente a valorización"
      }
    ],
    "followUpQuality": [
      {
        "key": "classifiedLeads",
        "label": "% leads clasificados",
        "formula": "classifiedLeads / activeLeads * 100",
        "meaning": "Disciplina de clasificación de leads"
      },
      {
        "key": "leadsManagedWithin90Days",
        "label": "% leads sin abandono de 90 días",
        "formula": "(1 - unmanaged90DayLeads / activeLeads) * 100",
        "meaning": "Leads activos no abandonados"
      },
      {
        "key": "priorityLeadsManagedWithin15Days",
        "label": "% leads A contactados en 15 días",
        "formula": "(1 - unmanaged15DayPriorityLeads / priorityClients) * 100",
        "meaning": "Atención oportuna de leads prioritarios"
      }
    ],
    "conversionQuality": [
      {
        "key": "completedVisitsGoal",
        "label": "Visitas realizadas frente a meta",
        "formula": "min(completedVisits / visitGoal, 1) * 100",
        "meaning": "Cumplimiento de meta de visitas"
      },
      {
        "key": "completedScheduledVisits",
        "label": "% visitas realizadas/agendadas",
        "formula": "completedVisits / scheduledVisits * 100",
        "meaning": "Cumplimiento de agenda"
      },
      {
        "key": "sixMonthCloseRate",
        "label": "Tasa de cierre 6 meses/leads totales",
        "formula": "min(sixMonthCloseRatePercent, 2.86) * 35",
        "meaning": "Conversión de oportunidades en negocios"
      }
    ],
    "trafficLights": {
      "goalCompliance": [
        { "status": "red", "condition": "value < 90" },
        { "status": "yellow", "condition": "value >= 90 && value < 100" },
        { "status": "green", "condition": "value >= 100" }
      ],
      "yearOverYearGrowth": [
        { "status": "red", "condition": "value < 0" },
        { "status": "yellow", "condition": "value >= 0 && value < 20" },
        { "status": "green", "condition": "value >= 20" }
      ],
      "qualityScore": [
        { "status": "red", "condition": "value < 50" },
        { "status": "yellow", "condition": "value >= 50 && value < 70" },
        { "status": "green", "condition": "value >= 70" }
      ]
    },
    "personClassifications": [
      { "key": "star", "label": "Estrella", "condition": "portfolio >= 70 && followUp >= 70 && conversion >= 70" },
      { "key": "potential", "label": "Potencial", "condition": "oneScore >= 70 && remainingScores >= 50" },
      { "key": "capturer", "label": "Captador", "condition": "portfolio >= 70" },
      { "key": "seller", "label": "Vendedor", "condition": "conversion >= 70" },
      { "key": "persistent", "label": "Perseverante", "condition": "followUp >= 70" },
      { "key": "risk", "label": "Riesgo", "condition": "atLeastTwoScores < 30" },
      { "key": "development", "label": "Desarrollo", "condition": "fallback" }
    ]
  },
