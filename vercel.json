{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm management:scoring:verify && pnpm management:reports:verify && pnpm management:persisted:verify && pnpm management:reconciliation:verify && pnpm management:delivery:verify && pnpm build",
  "crons": [
    {
      "path": "/api/cron/management-monthly",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/management-delivery",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/deliver-documents-weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/deliver-documents-monthly",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/document-delivery-claim",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/market-refresh",
      "schedule": "15 3 * * *"
    }
  ]
}
