# Supabase runtime configuration
# Store real values only in local secret storage, Vercel or GitHub Actions secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL used in authenticated report links.
APP_BASE_URL=https://n3uralia-intelligence-platform.vercel.app

# Vercel Cron authentication
# Required in Production for /api/cron/management-monthly and /api/cron/management-delivery.
CRON_SECRET=

# Report delivery through Resend.
# RESEND_API_KEY is private. Sender identities are non-secret and restricted to the allowlist.
# The worker remains inactive and does not consume retries while RESEND_API_KEY is empty.
RESEND_API_KEY=
REPORT_FROM_EMAIL=Property Partners Intelligence <reportes@ppartnersgroup.app>
REPORT_REPLY_TO=
REPORT_ALLOWED_FROM_DOMAINS=ppartnersgroup.app

# N3uralia canonical client reports. Keep the API key server-side only.
# GPT-5.6 Sol is the quality-first default for high-value client deliverables.
OPENAI_API_KEY=
OPENAI_CANONICAL_REPORT_MODEL=gpt-5.6-sol
OPENAI_CANONICAL_REPORT_REASONING_EFFORT=max
OPENAI_CANONICAL_REPORT_REASONING_MODE=pro

# Public API rate limiting (lib/public-rate-limit.ts)
# PUBLIC_RATE_LIMIT_MAX_PER_MINUTE default: 30. Subir durante UAT si los
# testers generan carga repetida (p. ej. 600). Nunca bajar la protección en
# producción sin un límite global (Upstash) como reemplazo.
PUBLIC_RATE_LIMIT_MAX_PER_MINUTE=30
# PUBLIC_RATE_LIMIT_DISABLED=true desactiva el límite. SÓLO ambientes de
# prueba; nunca en producción.
PUBLIC_RATE_LIMIT_DISABLED=false

# Authenticated QA runner (local or GitHub Actions only)
QA_BASE_URL=
QA_PASSWORD=
QA_CEO_EMAIL=
QA_CEO_PASSWORD=
QA_DIRECTOR_EMAIL=
QA_DIRECTOR_PASSWORD=
QA_SUBDIRECTOR_EMAIL=
QA_SUBDIRECTOR_PASSWORD=
QA_LO_BELTRAN_EMAIL=
QA_LO_BELTRAN_PASSWORD=
QA_NUEVA_COSTANERA_EMAIL=
QA_NUEVA_COSTANERA_PASSWORD=
QA_SANTA_MARIA_EMAIL=
QA_SANTA_MARIA_PASSWORD=
